+static jboolean JNICALL jni_freerdp_send_resize_event(JNIEnv* env, jclass cls, jlong instance,
+                                                      jint width, jint height)
+{
+	ANDROID_EVENT* event;
+	freerdp* inst = (freerdp*)instance;
+	if ((width < DISPLAY_CONTROL_MIN_MONITOR_WIDTH) ||
+	    (width > DISPLAY_CONTROL_MAX_MONITOR_WIDTH) ||
+	    (height < DISPLAY_CONTROL_MIN_MONITOR_HEIGHT) ||
+	    (height > DISPLAY_CONTROL_MAX_MONITOR_HEIGHT))
+		return JNI_FALSE;
+
+	event = (ANDROID_EVENT*)android_event_resize_new(width, height);
+	if (!event)
+		return JNI_FALSE;
+
+	if (!android_push_event(inst, event))
+	{
+		android_event_free(event);
+		return JNI_FALSE;
+	}
+	return JNI_TRUE;
+}
