+static jboolean JNICALL jni_freerdp_set_monitor_layout(JNIEnv* env, jclass cls, jlong instance,
+                                                       jint count, jint width, jint height)
+{
+	freerdp* inst = (freerdp*)instance;
+	rdpSettings* settings;
+	int i;
+
+	if (!env || !cls || !inst || !inst->settings || count < 2 || count > 16 || width <= 0 ||
+	    height <= 0 || ((INT64)count * width) > 32766 || height > 32766)
+		return JNI_FALSE;
+
+	settings = inst->settings;
+	settings->UseMultimon = TRUE;
+	settings->Fullscreen = TRUE;
+	settings->MonitorCount = count;
+	settings->DesktopWidth = count * width;
+	settings->DesktopHeight = height;
+	ZeroMemory(settings->MonitorDefArray, settings->MonitorDefArraySize * sizeof(rdpMonitor));
+	for (i = 0; i < count; i++)
+	{
+		rdpMonitor* monitor = &settings->MonitorDefArray[i];
+		monitor->x = i * width;
+		monitor->y = 0;
+		monitor->width = width;
+		monitor->height = height;
+		monitor->is_primary = (i == 0);
+		monitor->orig_screen = i;
+		monitor->attributes.desktopScaleFactor = 100;
+		monitor->attributes.deviceScaleFactor = 100;
+	}
+	return JNI_TRUE;
+}
