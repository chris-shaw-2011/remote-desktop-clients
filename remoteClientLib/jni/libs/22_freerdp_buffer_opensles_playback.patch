 // puts a buffer of size samples to the device
 int android_AudioOut(OPENSL_STREAM* p, const short* buffer, int size)
 {
+	SLresult result;
+	void* data;
+	BOOL restarting;
 	assert(p);
 	assert(buffer);
 	assert(size > 0);
@@ -344,7 +355,7 @@ int android_AudioOut(OPENSL_STREAM* p, const short* buffer, int size)
 		return -1;
 	}
 
-	void* data = calloc(size, sizeof(short));
+	data = calloc(size, sizeof(short));
 
 	if (!data)
 	{
@@ -353,9 +364,62 @@ int android_AudioOut(OPENSL_STREAM* p, const short* buffer, int size)
 	}
 
 	memcpy(data, buffer, size * sizeof(short));
-	Queue_Enqueue(p->queue, data);
-	(*p->bqPlayerBufferQueue)->Enqueue(p->bqPlayerBufferQueue, data, sizeof(short) * size);
+	Queue_Lock(p->queue);
+	restarting = !p->playing;
+	p->playing = TRUE;
+
+	if (restarting)
+	{
+		const size_t silenceSamples =
+		    ((size_t)p->sr * p->outchannels * AUDIO_PREBUFFER_MS) / 1000;
+		void* silence = calloc(silenceSamples, sizeof(short));
+		WLog_INFO(TAG, "Starting buffered OpenSL playback with %d ms prebuffer",
+		          AUDIO_PREBUFFER_MS);
+
+		if (!silence || !Queue_Enqueue(p->queue, silence))
+		{
+			free(silence);
+			free(data);
+			p->playing = FALSE;
+			Queue_Unlock(p->queue);
+			return -1;
+		}
+
+		result = (*p->bqPlayerBufferQueue)
+		             ->Enqueue(p->bqPlayerBufferQueue, silence,
+		                       sizeof(short) * silenceSamples);
+		if (result != SL_RESULT_SUCCESS)
+			goto fail;
+	}
+
+	if (!Queue_Enqueue(p->queue, data))
+	{
+		free(data);
+		goto fail;
+	}
+
+	result = (*p->bqPlayerBufferQueue)
+	             ->Enqueue(p->bqPlayerBufferQueue, data, sizeof(short) * size);
+	if (result != SL_RESULT_SUCCESS)
+		goto fail;
+
+	if (restarting)
+	{
+		result = (*p->bqPlayerPlay)->SetPlayState(p->bqPlayerPlay, SL_PLAYSTATE_PLAYING);
+		if (result != SL_RESULT_SUCCESS)
+			goto fail;
+	}
+
+	Queue_Unlock(p->queue);
 	return size;
+
+fail:
+	(*p->bqPlayerPlay)->SetPlayState(p->bqPlayerPlay, SL_PLAYSTATE_STOPPED);
+	(*p->bqPlayerBufferQueue)->Clear(p->bqPlayerBufferQueue);
+	Queue_Clear(p->queue);
+	p->playing = FALSE;
+	Queue_Unlock(p->queue);
+	return -1;
 }
 
