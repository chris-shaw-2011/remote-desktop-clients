+/* Configure one shared desktop before connecting. Each Quest panel copies its monitor region. */
+JNIEXPORT jboolean JNICALL
+Java_com_freerdp_freerdpcore_services_LibFreeRDP_freerdp_1set_1monitor_1layout(
+    JNIEnv* env, jclass cls, jlong instance, jint count, jint width, jint height)
+{
+	freerdp* inst = (freerdp*)instance;
+	rdpMonitor monitors[16] = WINPR_C_ARRAY_INIT;
+
+	if (!env || !cls || !inst || !inst->context || !inst->context->settings || count < 1 ||
+	    count > 16 || width <= 0 || height <= 0 || ((INT64)count * width) > 32766 ||
+	    height > 32766)
+		return JNI_FALSE;
+
+	for (jint i = 0; i < count; i++)
+	{
+		rdpMonitor* monitor = &monitors[i];
+		monitor->x = i * width;
+		monitor->width = width;
+		monitor->height = height;
+		monitor->is_primary = (i == 0);
+		monitor->orig_screen = (UINT32)i;
+		monitor->attributes.desktopScaleFactor = 100;
+		monitor->attributes.deviceScaleFactor = 100;
+	}
+
+	rdpSettings* settings = inst->context->settings;
+	if (!freerdp_settings_set_monitor_def_array_sorted(settings, monitors, (size_t)count) ||
+	    !freerdp_settings_set_bool(settings, FreeRDP_UseMultimon, count > 1) ||
+	    !freerdp_settings_set_uint32(settings, FreeRDP_DesktopWidth, (UINT32)(count * width)) ||
+	    !freerdp_settings_set_uint32(settings, FreeRDP_DesktopHeight, (UINT32)height))
+		return JNI_FALSE;
+
+	if ((count > 1) && !freerdp_settings_set_bool(settings, FreeRDP_Fullscreen, TRUE))
+		return JNI_FALSE;
+
+	return JNI_TRUE;
+}
