<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto"
    android:versionCode="116490"
    android:versionName="v6.4.9">

    <uses-permission tools:node="removeAll" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name="com.iiordanov.ardp.ArdpApp"
        android:allowBackup="false"
        android:banner="@mipmap/banner_ardp"
        android:icon="@mipmap/icon_ardp"
        android:label="@string/ardp_app_name"
        android:theme="@style/AppThemeDayNight"
        tools:replace="android:label,android:theme">
        <activity
            android:name="com.undatech.opaque.ConnectionGridActivity"
            android:configChanges="keyboardHidden"
            android:documentLaunchMode="always"
            android:exported="true"
            android:label="@string/ardp_app_name"
            android:launchMode="standard"
            android:resizeableActivity="true"
            android:taskAffinity="com.iiordanov.aRDP.connectionPicker"
            android:theme="@style/AppThemeDayNight"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.iiordanov.bVNC.aRDP"
            android:configChanges="orientation|keyboardHidden"
            android:label="@string/ardp_app_name"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser"
            android:theme="@style/AppThemeDayNight"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name="com.iiordanov.bVNC.RemoteCanvasActivity"
            android:configChanges="colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:documentLaunchMode="always"
            android:exported="true"
            android:launchMode="standard"
            android:resizeableActivity="true"
            android:taskAffinity="com.iiordanov.aRDP.rdpSession"
            android:theme="@style/AppTheme"
            tools:replace="android:launchMode"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="rdp" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="intent" />
                <data android:mimeType="application/vnd.rdp" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:host="*"/>
                <data android:mimeType="application/rdp"/>
                <data android:mimeType="application/x-rdp"/>
                <data android:scheme="file"/>
                <data android:scheme="content"/>
                <data android:pathPattern=".*\\.rdp"/>
            </intent-filter>
        </activity>
        <activity
            android:name="com.iiordanov.bVNC.InPlaceRemoteCanvasActivity"
            android:configChanges="colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:documentLaunchMode="never"
            android:exported="false"
            android:launchMode="standard"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser"
            android:taskAffinity="com.iiordanov.aRDP.rdpSession"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <service
            android:name="com.iiordanov.bVNC.input.SystemKeyCaptureService"
            android:description="@string/system_key_capture_description"
            android:exported="true"
            android:label="@string/system_key_capture_title"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/system_key_capture_service" />
        </service>
        <receiver
            android:name="com.iiordanov.ardp.ArdpUpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
